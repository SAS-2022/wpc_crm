rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function isGm() { return active() && me().role == 'gm'; }
    function isAdmin() { return active() && me().role in ['sales_manager', 'gm']; }
    function isSupervisor() { return active() && me().role in ['kam', 'sales_manager', 'gm']; }
    // The sales team; HR, accounting and procurement are not (no clients, visits, plans).
    function isSales() { return active() && me().role in ['sales_exec', 'kam', 'sales_manager', 'gm']; }
    // HR, GM and (for now, to test) the sales manager see the HR area.
    // Edits leave types, holidays, balances and request details: HR and GM,
    // and the sales manager for now (testing, user decision 2026-10-17).
    function managesHr() { return active() && me().role in ['hr', 'gm', 'sales_manager']; }
    function isHrArea() { return active() && me().role in ['hr', 'gm', 'sales_manager']; }
    // Managers (2026-10-23): manager roles, people marked "Is a manager" and
    // warehouse supervisors. They read attendance and reported absences;
    // the app shows only the people under them.
    function isManagerUser() {
      return active() && (me().role in ['kam', 'sales_manager', 'gm', 'logistics_manager', 'warehouse_supervisor']
        || me().get('isManager', false) == true);
    }
    function ownsClient(clientId) {
      return active() && get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTo == request.auth.uid;
    }
    function ownsVisit(visitId) {
      return active() && get(/databases/$(database)/documents/visits/$(visitId)).data.salesExecId == request.auth.uid;
    }

    // GM / sales manager create and edit users; deleting is done by the deleteUser function.
    // The logistics manager creates and edits drivers only (2026-10-23).
    match /users/{uid} {
      allow read: if request.auth.uid == uid || active();
      allow create, update: if isAdmin();
      allow create: if active() && me().role == 'logistics_manager' && request.resource.data.role == 'driver';
      allow update: if active() && me().role == 'logistics_manager'
        && resource.data.role == 'driver' && request.resource.data.role == 'driver'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approval', 'updateRemindedAt']);
      // Self-registration: a new account creates its own profile, inactive
      // and pending, with no role; the sales manager / GM approve it.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'position', 'companyId', 'role',
             'active', 'approval', 'registeredAt'])
        && request.resource.data.role == '' && request.resource.data.active == false
        && request.resource.data.approval == 'pending';
      // Profile page: everyone edits their own name and phone; the app saves
      // the version it runs (`appVersions`). Update reminders are admin-only.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'appVersions']);
      // HR sets each person's joining date and department (2026-10-24).
      allow update: if managesHr()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joiningDate', 'department']);
      // Only the `deleteUser` Cloud Function deletes users (allowed accounts
      // only, user decision 2026-10-23).
      allow delete: if false;

      // Push tokens of the user's phones, written by the app, read by the sendPush function.
      match /devices/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // KAM, sales manager and GM can edit clients; a sales exec edits contact
    // details, locations and notes of their own clients (not category or assignment).
    match /clients/{clientId} {
      allow read: if isSupervisor() || (active() && resource.data.assignedTo == request.auth.uid);
      // KAM / managers add any client; a sales exec adds clients for themselves.
      allow create: if isSupervisor()
        || (isSales() && request.resource.data.assignedTo == request.auth.uid
            && request.resource.data.source == 'manual');
      allow delete: if isAdmin();
      // `givenLog` (`given` = older summary): catalogs / stands handed over, at
      // visits or recorded on the client page. `statusRequest`: see below.
      allow update: if isSupervisor()
        || (active() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastVisitAt', 'lat', 'lng', 'mainLocationType', 'extraLocations', 'name', 'contactPerson',
              'phone', 'mobile', 'email', 'address', 'city', 'notes', 'updatedAt', 'given', 'givenLog',
              'statusRequest'])
            // Asks for a status change (closed / not working) as themselves,
            // or withdraws it; KAM / managers approve and set `status`.
            && (!('statusRequest' in request.resource.data)
                || request.resource.data.statusRequest == null
                || request.resource.data.statusRequest.byId == request.auth.uid));

      match /attachments/{attachmentId} {
        allow read, create: if isSupervisor() || ownsClient(clientId);
        allow delete: if isSupervisor();
      }
    }

    match /visits/{visitId} {
      allow read: if isSupervisor() || (active() && resource.data.salesExecId == request.auth.uid);
      allow create: if isSales() && request.resource.data.salesExecId == request.auth.uid;
      // A KAM only marks / unmarks themselves as having been at the visit.
      allow update: if isAdmin()
        || (isSupervisor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kamId', 'kamMarkedAt'])
            && (request.resource.data.kamId == request.auth.uid
                || (resource.data.kamId == request.auth.uid && request.resource.data.kamId == null)));
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSupervisor() || ownsVisit(visitId);
        allow create: if (isSupervisor() || ownsVisit(visitId)) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if active() && resource.data.authorId == request.auth.uid;
      }

      match /attachments/{attachmentId} {
        allow read, create: if isSupervisor() || ownsVisit(visitId);
        allow delete: if isSupervisor();
      }
    }

    // Daily plans. A sales exec's own tasks start as pending; KAM / managers
    // add approved tasks and approve or reject. The owner only ticks done and
    // edits the checklist of a visit (adds, ticks, comments).
    match /tasks/{taskId} {
      allow read: if isSupervisor() || (active() && resource.data.ownerId == request.auth.uid);
      allow create: if isSales() && request.resource.data.createdBy == request.auth.uid
        && (isSupervisor()
            || (request.resource.data.ownerId == request.auth.uid && request.resource.data.approval == 'pending'));
      allow update: if isSupervisor()
        || (active() && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'visitId', 'checklist']));
      allow delete: if isSupervisor()
        || (active() && resource.data.ownerId == request.auth.uid && resource.data.approval != 'approved');
    }

    // In-app notifications: written by the sender, read and marked read by the recipient.
    match /notifications/{notificationId} {
      allow read, delete: if active() && resource.data.toId == request.auth.uid;
      allow create: if active() && request.resource.data.fromId == request.auth.uid;
      allow update: if active() && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Companies people work for: listed on the registration form (before
    // signing in), managed by the sales manager / GM.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Work sites for attendance (sales manager / GM).
    // Vehicles (2026-10-24): the sales manager, GM and logistics manager
    // keep them (details, drivers, renewals, odometer readings). Drivers'
    // GPS km per day are written by Cloud Functions only.
    function managesVehicles() { return active() && me().role in ['sales_manager', 'gm', 'logistics_manager']; }
    match /vehicles/{vehicleId} {
      allow read, write: if managesVehicles();
    }
    match /driver_km/{id} {
      allow read: if managesVehicles();
      allow write: if false;
    }

    match /work_sites/{siteId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Attendance days `{uid}_{yyyy-MM-dd}`: the phone only adds events; the
    // check-in / check-out result is written by Cloud Functions. Read: the
    // person, the HR area and KAM / managers.
    // Day timelines (GPS split into client / driving / office / lunch /
    // stopped time), written only by Cloud Functions.
    match /day_timelines/{id} {
      // Logistics manager: drivers; warehouse supervisor: their own drivers.
      allow read: if isSupervisor() || (active() && resource.data.uid == request.auth.uid)
        || (active() && me().role == 'logistics_manager'
            && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.role == 'driver')
        || (active() && me().role == 'warehouse_supervisor'
            && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.get('supervisorId', '') == request.auth.uid);
      allow write: if false;
    }

    match /attendance/{dayId} {
      allow read: if isHrArea() || isManagerUser() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && dayId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['uid', 'date', 'month', 'events'])
        // HR corrects a day (2026-10-22), also one the person has no record of.
        || (managesHr() && dayId == request.resource.data.uid + '_' + request.resource.data.date
            && request.resource.data.keys().hasOnly(['uid', 'date', 'month', 'correction']));
      allow update: if (active() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events']))
        || (managesHr() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correction']));
    }

    // "Not coming to work" (2026-10-22): the person reports their own day
    // (`{uid}_{date}`) and may change or take it back while it waits; HR or
    // the GM accept or reject it (never their own). Read like attendance.
    // Leaving early (2026-10-23, early_checkout.dart): `{uid}_{yyyy-MM-dd}`.
    // The person asks their direct manager(s) (`approverIds`, never
    // themselves); one of them approves or rejects while it waits.
    match /checkout_requests/{requestId} {
      function validAsk() {
        return active() && request.resource.data.uid == request.auth.uid
          && requestId == request.auth.uid + '_' + request.resource.data.date
          && request.resource.data.status == 'pending'
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
          && request.resource.data.approverIds is list && request.resource.data.approverIds.size() > 0
          && !(request.auth.uid in request.resource.data.approverIds)
          && request.resource.data.keys().hasOnly(['uid', 'date', 'month', 'reason', 'approverIds', 'status', 'createdAt']);
      }
      allow read: if isHrArea() || (active() && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.approverIds));
      // Asking again after an answer replaces the request.
      allow create, update: if validAsk();
      allow update: if active() && request.auth.uid in resource.data.approverIds && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'comment', 'decidedBy', 'decidedAt']);
      allow delete: if active() && resource.data.uid == request.auth.uid && resource.data.status == 'pending';
    }

    match /absences/{absenceId} {
      // sales_manager: acts as HR until HR has an account (user request 2026-10-22, testing).
      function decidesAbsences() { return active() && me().role in ['hr', 'gm', 'sales_manager']; }
      function validReport() {
        return active() && request.resource.data.uid == request.auth.uid
          && absenceId == request.auth.uid + '_' + request.resource.data.date
          && request.resource.data.reason in ['sick', 'tired', 'cantCome']
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['uid', 'date', 'month', 'reason', 'note', 'status', 'createdAt']);
      }
      allow read: if isHrArea() || isManagerUser() || (active() && resource.data.uid == request.auth.uid);
      allow create: if validReport();
      allow update: if (validReport() && resource.data.status == 'pending')
        || (decidesAbsences() && resource.data.uid != request.auth.uid
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'countAs', 'comment', 'decidedBy', 'decidedAt', 'leaveRequestId']));
      allow delete: if (active() && resource.data.uid == request.auth.uid && resource.data.status == 'pending') || managesHr();

      // Documents (e.g. a medical report): the person adds them while it waits, the HR area too.
      match /attachments/{attachmentId} {
        function parent() { return get(/databases/$(database)/documents/absences/$(absenceId)).data; }
        allow read: if isHrArea() || isSupervisor() || (active() && parent().uid == request.auth.uid);
        allow create: if managesHr() || (active() && parent().uid == request.auth.uid && parent().status == 'pending');
        allow delete: if managesHr();
      }
    }

    // App settings such as visit frequency per client category.
    match /settings/{settingId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /import_batches/{batchId} {
      allow read, write: if isAdmin();
    }

    // HR edits leave types and public holidays (everyone reads them, as settings).
    // Job positions: listed on the registration form, before signing in.
    match /settings/positions {
      allow read: if true;
    }
    match /settings/leaveTypes {
      allow write: if managesHr();
    }
    match /settings/holidays {
      allow write: if managesHr();
    }
    // Whether annual leave carries over, and the departments list (2026-10-24).
    match /settings/leavePolicy {
      allow write: if managesHr();
    }
    match /settings/departments {
      allow write: if managesHr();
    }

    // Leave and other employee requests. The owner sends and may cancel while
    // waiting; each step of the chain is decided, in order, by the user (KAM)
    // or role the request's `awaitingKey` names, never by the requester.
    // HR / GM may correct the details (dates, days, type, reason) but not the
    // approval fields, so nobody skips the order. The HR area (HR, GM, SM)
    // reads all; a KAM reads their team's (`kamId`).
    match /leave_requests/{requestId} {
      function ownsRequest() { return active() && resource.data.uid == request.auth.uid; }
      function awaitsMe() {
        return resource.data.awaitingKey == 'uid:' + request.auth.uid
          || resource.data.awaitingKey == 'role:' + me().role;
      }
      // Managers too (2026-10-23): their people's leave on the Attendance
      // page and report; the app shows only the people under them. KAMs
      // keep to their own team (`kamId`).
      allow read: if ownsRequest() || isHrArea() || (isManagerUser() && me().role != 'kam')
        || (active() && resource.data.kamId == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stepIndex == 0
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps[request.resource.data.steps.size() - 1].role in ['hr', 'gm']
        // HR / GM accepting someone's reported absence as leave: approved at once.
        || (active() && me().role in ['hr', 'gm', 'sales_manager'] && request.resource.data.uid != request.auth.uid
            && request.resource.data.status == 'approved'
            && request.resource.data.absenceId is string
            && exists(/databases/$(database)/documents/absences/$(request.resource.data.absenceId)));
      allow update: if (managesHr()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'steps', 'stepIndex', 'awaitingKey', 'status', 'decidedAt']))
        || (ownsRequest() && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'awaitingKey', 'updatedAt']))
        || (active() && resource.data.status == 'pending' && resource.data.uid != request.auth.uid && awaitsMe()
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['steps', 'stepIndex', 'awaitingKey', 'status', 'updatedAt', 'decidedAt']));
      allow delete: if managesHr();

      // Documents (e.g. a hospital report): the owner adds them, HR may too.
      match /attachments/{attachmentId} {
        function parent() { return get(/databases/$(database)/documents/leave_requests/$(requestId)).data; }
        allow read: if isHrArea() || (active() && (parent().uid == request.auth.uid || parent().kamId == request.auth.uid));
        allow create: if managesHr() || (active() && parent().uid == request.auth.uid);
        allow delete: if managesHr();
      }
    }

    // HR's yearly days and adjustments per person: `{uid}_{year}`.
    match /leave_balances/{balanceId} {
      // By id, so the owner may also read a record HR hasn't created yet.
      allow read: if isHrArea() || (active() && balanceId.split('_')[0] == request.auth.uid);
      allow write: if managesHr();
    }

    // Closed leave years (2026-10-24), written by the closeLeaveYears function.
    match /leave_history/{id} {
      allow read: if isHrArea() || (active() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
