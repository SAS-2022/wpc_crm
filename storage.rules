rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function supervisor() {
      return request.auth != null && profile().active == true
        && profile().role in ['kam', 'sales_manager', 'gm'];
    }
    // Same access as the Firestore attachment lists: KAM / managers, or the
    // client's sales exec / the visit's author.
    function canAccess(folder, parentId) {
      return request.auth != null && (supervisor()
        || (folder == 'clients'
            && firestore.get(/databases/(default)/documents/clients/$(parentId)).data.assignedTo == request.auth.uid)
        || (folder == 'visits'
            && firestore.get(/databases/(default)/documents/visits/$(parentId)).data.salesExecId == request.auth.uid));
    }

    // Leave request documents: the owner and HR / GM / SM add; the HR area,
    // the owner and their KAM read.
    match /leave_requests/{requestId}/{fileName} {
      function req() { return firestore.get(/databases/(default)/documents/leave_requests/$(requestId)).data; }
      function hrArea() { return request.auth != null && profile().active == true && profile().role in ['hr', 'gm', 'sales_manager']; }
      allow read: if hrArea() || (request.auth != null && (req().uid == request.auth.uid || req().kamId == request.auth.uid));
      allow create: if request.resource.size < 20 * 1024 * 1024
        && (req().uid == request.auth.uid
            || (request.auth != null && profile().active == true && profile().role in ['hr', 'gm', 'sales_manager']));
      allow delete: if request.auth != null && profile().active == true && profile().role in ['hr', 'gm', 'sales_manager'];
    }

    // Reported absence documents (medical report): the person and the HR area
    // add; the HR area, supervisors and the person read.
    match /absences/{absenceId}/{fileName} {
      function absence() { return firestore.get(/databases/(default)/documents/absences/$(absenceId)).data; }
      function hrArea() { return request.auth != null && profile().active == true && profile().role in ['hr', 'gm', 'sales_manager']; }
      allow read: if hrArea() || supervisor() || (request.auth != null && absence().uid == request.auth.uid);
      allow create: if request.resource.size < 20 * 1024 * 1024
        && (hrArea() || (request.auth != null && absence().uid == request.auth.uid));
      allow delete: if hrArea();
    }

    // Client and visit attachments, max 20 MB each.
    match /{folder}/{parentId}/{fileName} {
      allow read: if folder in ['clients', 'visits'] && canAccess(folder, parentId);
      allow create: if folder in ['clients', 'visits'] && request.resource.size < 20 * 1024 * 1024
        && canAccess(folder, parentId);
      allow delete: if folder in ['clients', 'visits'] && supervisor();
    }
  }
}
