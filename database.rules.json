{
  "rules": {
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('roles').child(auth.uid).val() === 'gm' || (root.child('roles').child(auth.uid).val() === 'sales_manager' && newData.exists()) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' && newData.val() === 'driver' && (!data.exists() || data.val() === 'driver'))",
        ".validate": "newData.isString() && newData.val().matches(/^(sales_exec|kam|sales_manager|gm|hr|accounting|procurement|worker|engineer|driver|logistics_manager|warehouse_supervisor)$/)"
      }
    },
    "live_locations": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },
    "presence": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()"
      }
    },
    "location_history": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid",
        "$day": {
          "$point": {
            ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['lat', 'lng', 't'])"
          }
        }
      }
    },
    "route_snapped": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid"
      }
    },
    "tracking_device": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && root.child('roles').child(auth.uid).exists()) || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'sales_manager')",
        ".validate": "!newData.exists() || (newData.hasChildren(['id']) && newData.child('id').isString())"
      }
    },
    "tracking_events": {
      ".read": "root.child('roles').child(auth.uid).val() === 'kam' || root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'logistics_manager'",
      "$uid": {
        ".read": "root.child('driver_supervisors').child($uid).val() === auth.uid"
      }
    },
    "settings": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'sales_manager'",
      "workHours": {
        ".validate": "newData.hasChildren(['days', 'start', 'end']) && newData.child('start').isNumber() && newData.child('end').isNumber() && newData.child('end').val() > newData.child('start').val()"
      }
    },
    "driver_supervisors": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('roles').child(auth.uid).val() === 'gm' || root.child('roles').child(auth.uid).val() === 'sales_manager' || (root.child('roles').child(auth.uid).val() === 'logistics_manager' && root.child('roles').child($uid).val() === 'driver')",
        ".validate": "newData.isString()"
      }
    }
  }
}
