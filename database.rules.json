{
  "rules": {
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || ((root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) && newData.exists()) || ((root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true) && newData.isString() && newData.val().matches(/^(worker|driver|warehouse_supervisor)$/) && (!data.exists() || data.val().matches(/^(worker|driver|warehouse_supervisor)$/))) || ((root.child('roles').child(auth.uid).val() === 'factory_manager' || root.child('role_extras').child(auth.uid).child('factory_manager').val() === true) && newData.isString() && newData.val().matches(/^(worker|engineer|operator)$/) && (!data.exists() || data.val().matches(/^(worker|engineer|operator)$/))) || ((root.child('roles').child(auth.uid).val() === 'hr' || root.child('role_extras').child(auth.uid).child('hr').val() === true) && newData.isString() && newData.val().matches(/^(hr|accounting|procurement|worker|engineer|driver|logistics_manager|warehouse_supervisor|factory_manager|operator)$/) && (!data.exists() || data.val().matches(/^(hr|accounting|procurement|worker|engineer|driver|logistics_manager|warehouse_supervisor|factory_manager|operator)$/)))",
        ".validate": "newData.isString() && newData.val().matches(/^(sales_exec|kam|sales_manager|gm|hr|accounting|procurement|worker|engineer|driver|logistics_manager|warehouse_supervisor|factory_manager|operator)$/)"
      }
    },
    "live_locations": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid || root.child('location_viewers').child($uid).child(auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },
    "presence": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid || root.child('location_viewers').child($uid).child(auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()"
      }
    },
    "location_history": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid || root.child('location_viewers').child($uid).child(auth.uid).val() === true",
        "$day": {
          "$point": {
            ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['lat', 'lng', 't'])"
          }
        }
      }
    },
    "route_snapped": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('driver_supervisors').child($uid).val() === auth.uid"
      }
    },
    "tracking_device": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && root.child('roles').child(auth.uid).exists()) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true))",
        ".validate": "!newData.exists() || (newData.hasChildren(['id']) && newData.child('id').isString())"
      }
    },
    "device_status": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'factory_manager' || root.child('role_extras').child(auth.uid).child('factory_manager').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || root.child('location_viewers').child($uid).child(auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()"
      }
    },
    "tracking_events": {
      ".read": "(root.child('roles').child(auth.uid).val() === 'kam' || root.child('role_extras').child(auth.uid).child('kam').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true)",
      "$uid": {
        ".read": "root.child('driver_supervisors').child($uid).val() === auth.uid"
      }
    },
    "settings": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "(root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true)",
      "workHours": {
        ".validate": "newData.hasChildren(['days', 'start', 'end']) && newData.child('start').isNumber() && newData.child('end').isNumber() && newData.child('end').val() > newData.child('start').val()"
      }
    },
    "driver_supervisors": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(root.child('roles').child(auth.uid).val() === 'gm' || root.child('role_extras').child(auth.uid).child('gm').val() === true) || (root.child('roles').child(auth.uid).val() === 'sales_manager' || root.child('role_extras').child(auth.uid).child('sales_manager').val() === true) || (((root.child('roles').child(auth.uid).val() === 'logistics_manager' || root.child('role_extras').child(auth.uid).child('logistics_manager').val() === true) || (root.child('roles').child(auth.uid).val() === 'hr' || root.child('role_extras').child(auth.uid).child('hr').val() === true)) && root.child('roles').child($uid).val() === 'driver')",
        ".validate": "newData.isString()"
      }
    },
    "location_viewers": {
      ".read": false,
      ".write": false
    },
    "role_extras": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('roles').child(auth.uid).val() === 'gm' || (root.child('roles').child(auth.uid).val() === 'sales_manager' && !newData.child('gm').exists())",
        "$role": {
          ".validate": "newData.val() === true && $role.matches(/^(sales_exec|kam|sales_manager|gm|hr|accounting|procurement|worker|engineer|driver|logistics_manager|warehouse_supervisor|factory_manager|operator)$/)"
        }
      }
    }
  }
}
